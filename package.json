{
  "name": "camping-gear",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && composer run dev",
    "dev:mobile": "npm run start -w mobile",
    "build:web": "npm run build:ssr -w web",
    "test:web": "cd apps/web && composer test",
    "lint": "npm run check -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write apps/mobile/src packages/shared/src scripts && npm run check:fix -w web",
    "placeholders": "node scripts/generate-placeholders.mjs"
  },
  "devDependencies": {
    "prettier": "^3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
